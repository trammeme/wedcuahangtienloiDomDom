@model DD.Models.KhuyenMai

@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    <link href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css" rel="stylesheet" />

}

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    <div class="form-group">
        @Html.LabelFor(model => model.MaKhuyenMai)
        @Html.TextBoxFor(model => model.MaKhuyenMai, new { @class = "form-control", @readonly = "readonly" })
        @Html.ValidationMessageFor(model => model.MaKhuyenMai)
    </div>
    <div class="form-group">
        @Html.LabelFor(model => model.TenKhuyenMai)
        @Html.TextBoxFor(model => model.TenKhuyenMai, new { @class = "form-control" })
        @Html.ValidationMessageFor(model => model.TenKhuyenMai)
    </div>
    <div class="form-group">
        @Html.LabelFor(model => model.MoTa)
        @Html.TextAreaFor(model => model.MoTa, new { @class = "form-control" })
        @Html.ValidationMessageFor(model => model.MoTa)
    </div>
    <div class="form-group">
        @Html.LabelFor(model => model.NgayBatDau)
        @Html.TextBoxFor(model => model.NgayBatDau, new { @class = "form-control", type = "date" })
        @Html.ValidationMessageFor(model => model.NgayBatDau)
    </div>
    <div class="form-group">
        @Html.LabelFor(model => model.NgayKetThuc)
        @Html.TextBoxFor(model => model.NgayKetThuc, new { @class = "form-control", type = "date" })
        @Html.ValidationMessageFor(model => model.NgayKetThuc)
    </div>
    <div class="form-group">
        @Html.LabelFor(model => model.MaSanPhamKM)
        @Html.TextBoxFor(model => model.MaSanPhamKM, new { @class = "form-control" })
        @Html.ValidationMessageFor(model => model.MaSanPhamKM)
    </div>
    <div class="form-group">
        @Html.LabelFor(model => model.HinhAnh)
        @Html.TextBoxFor(model => model.HinhAnh, new { @class = "form-control", value = Model.HinhAnh?.Replace("~/Image/sale/", "") })
        @Html.ValidationMessageFor(model => model.HinhAnh)
        <small>Nhập tên file ảnh (ví dụ: hinhanh.jpg). Để nguyên nếu không thay đổi.</small>
        @if (!string.IsNullOrEmpty(Model.HinhAnh))
        {
            <img src="@Url.Content(Model.HinhAnh)" alt="Hình ảnh hiện tại" style="width:100px; height:auto; margin-top:10px;" />
        }
    </div>
    <button type="submit" class="btn btn-primary">Cập nhật</button>
}