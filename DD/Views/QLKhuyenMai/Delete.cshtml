@model DD.Models.KhuyenMaiViewModel

@{
    Layout = null;
}
<h2>Xóa khuyến mãi</h2>

<h3>Bạn có chắc chắn muốn xóa khuyến mãi này?</h3>
<div>
    <h4>Thông tin khuyến mãi</h4>
    <hr />
    <dl class="dl-horizontal">
        <dt>@Html.DisplayNameFor(model => model.MaKhuyenMai)</dt>
        <dd>@Html.DisplayFor(model => model.MaKhuyenMai)</dd>

        <dt>@Html.DisplayNameFor(model => model.TenKhuyenMai)</dt>
        <dd>@Html.DisplayFor(model => model.TenKhuyenMai)</dd>

        <dt>@Html.DisplayNameFor(model => model.MoTa)</dt>
        <dd>@Html.DisplayFor(model => model.MoTa)</dd>

        <dt>@Html.DisplayNameFor(model => model.NgayBatDau)</dt>
        <dd>@Html.DisplayFor(model => model.NgayBatDau)</dd>

        <dt>@Html.DisplayNameFor(model => model.NgayKetThuc)</dt>
        <dd>@Html.DisplayFor(model => model.NgayKetThuc)</dd>

        <dt>@Html.DisplayNameFor(model => model.HinhAnh)</dt>
        <dd>@Html.DisplayFor(model => model.HinhAnh)</dd>
    </dl>

    @using (Html.BeginForm("DeleteConfirmed", "QLKhuyenMai", FormMethod.Post))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(model => model.MaKhuyenMai)
        <div class="form-actions no-color">
            <input type="submit" value="Xóa" class="btn btn-danger" /> |
            @Html.ActionLink("Quay lại", "Index")
        </div>
    }
    }
