@model IEnumerable<DD.Models.NguoiDung>
@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

<div class="container mt-4">
    @if (TempData["Message"] != null)
    {
        <div class="alert alert-success text-center">
            @TempData["Message"]
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger text-center">
            @TempData["ErrorMessage"]
        </div>
    }

    <h2 class="text-center mb-4">Danh sách Khách hàng</h2>

    <!-- Thêm nút Xuất Excel -->
    <div class="mb-3">
        <a href="@Url.Action("ExportToExcel", "QuanLyUser")" class="btn btn-primary">Xuất Excel</a>
    </div>

    <table class="table table-bordered table-striped">
        <thead class="table-light">
            <tr>
                <th>MÃ KH</th>
                <th>TÊN KH</th>
                <th>EMAIL</th>
                <th>GIỚI TÍNH</th>
                <th>THÁNG SINH</th>
                <th>ĐỊA CHỈ</th>
                <th>ĐIỆN THOẠI</th>
                <th>ĐĂNG NHẬP</th>
                <th>MẬT KHẨU</th>
                <th>HÀNH ĐỘNG</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.MaKH</td>
                    <td>@item.TenKH</td>
                    <td>@item.Email</td>
                    <td>@item.GioiTinh</td>
                    <td>@item.ThangSinh</td>
                    <td>@item.DiaChi</td>
                    <td>@item.SoDienThoai</td>
                    <td>@item.TenDangNhap</td>
                    <td>@item.MatKhau</td>
                    <td>
                        <a href="#" class="btn btn-primary btn-sm" onclick="loadModal('@Url.Action("Edit", "QuanLyUser", new { id = item.MaKH })'); return false;">Sửa</a>
                        <a href="#" class="btn btn-info btn-sm" onclick="loadModal('@Url.Action("Detail", "QuanLyUser", new { id = item.MaKH })'); return false;">Xem</a>

                        <form id="deleteForm_@item.MaKH" action="@Url.Action("DeleteConfirmed", "QuanLyUser")" method="post" style="display:inline;">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@item.MaKH" />
                            <button type="button" onclick="confirmDelete(@item.MaKH)" class="btn btn-danger btn-sm">Xóa</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<!-- Modal for Edit/Delete/View -->
<div class="modal fade" id="userModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content" id="userModalContent">
            <!-- Nội dung sẽ được nạp qua AJAX -->
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        function loadModal(url) {
            $.get(url, function (data) {
                $('#userModalContent').html(data);
                var modal = new bootstrap.Modal(document.getElementById('userModal'));
                modal.show();
            });
        }

        function confirmDelete(id) {
            if (confirm("Bạn có chắc chắn muốn xóa người dùng này?")) {
                var form = $('#deleteForm_' + id);
                $.ajax({
                    url: form.attr('action'),
                    type: 'POST',
                    data: form.serialize(),
                    success: function () {
                        location.reload();
                    },
                    error: function (xhr, status, error) {
                        alert("Đã xảy ra lỗi khi xóa: " + error);
                    }
                });
            }
        }
    </script>
}