@model DD.Models.NguoiDung

@{
    Layout = null;
    <link href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css" rel="stylesheet" />

}
<style>
   
</style>
<!DOCTYPE html>

<html lang="vi">
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Chi Tiết Người Dùng</title>
</head>
<body>
    <div class="container">
        <h4>Chi Tiết Người Dùng</h4>
        <hr />
        <dl class="dl-horizontal">
            <dt>
                Mã Khách Hàng
            </dt>
            <dd>
                @Html.DisplayFor(model => model.MaKH)
            </dd>

            <dt>
                Tên Khách Hàng
            </dt>
            <dd>
                @Html.DisplayFor(model => model.TenKH)
            </dd>

            <dt>
                Email
            </dt>
            <dd>
                @Html.DisplayFor(model => model.Email)
            </dd>

            <dt>
                Giới Tính
            </dt>
            <dd>
                @Html.DisplayFor(model => model.GioiTinh)
            </dd>

            <dt>
                Tháng Sinh
            </dt>
            <dd>
                @Html.DisplayFor(model => model.ThangSinh)
            </dd>

            <dt>
                Địa Chỉ
            </dt>
            <dd>
                @Html.DisplayFor(model => model.DiaChi)
            </dd>

            <dt>
                Số Điện Thoại
            </dt>
            <dd>
                @Html.DisplayFor(model => model.SoDienThoai)
            </dd>

            <dt>
                Tên Đăng Nhập
            </dt>
            <dd>
                @Html.DisplayFor(model => model.TenDangNhap)
            </dd>

            <dt>
                Mật Khẩu
            </dt>
            <dd>
                @Html.DisplayFor(model => model.MatKhau)
            </dd>
        </dl>

        <p>
            <a href="@Url.Action("Index", "Admin")" class="btn">Quay về menu chính</a>
        </p>
    </div>
</body>
</html>