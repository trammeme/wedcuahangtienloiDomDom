@model DD.Models.SanPham
@{
    ViewBag.Title = "Xóa sản phẩm";
    Layout = "~/Views/Shared/_Layout.cshtml"; // hoặc Layout = null nếu bạn không dùng layout
}

<h3>Bạn có chắc chắn muốn xóa sản phẩm này?</h3>
<hr />
<dl class="dl-horizontal">
    <dt>Mã sản phẩm</dt>
    <dd>@Html.DisplayFor(m => m.MaSanPham)</dd>

    <dt>Tên sản phẩm</dt>
    <dd>@Html.DisplayFor(m => m.TenSanPham)</dd>

    <dt>Mô tả</dt>
    <dd>@Html.DisplayFor(m => m.MoTa)</dd>

    <dt>Giá</dt>
    <dd>@Html.DisplayFor(m => m.Gia)</dd>

    <dt>Loại</dt>
    <dd>@Html.DisplayFor(m => m.LoaiSanPham)</dd>

    <dt>Hình ảnh</dt>
    <dd>
        @if (!string.IsNullOrEmpty(Model.HinhAnh))
        {
            <img src="@Url.Content(Model.HinhAnh)" style="max-width: 200px;" />
        }
        else
        {
            <span>Không có hình</span>
        }
    </dd>
</dl>

@using (Html.BeginForm("Delete", "SanPham", FormMethod.Post))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(model => model.MaSanPham)

    <div class="form-actions">
        <input type="submit" value="Xóa" class="btn btn-danger" />
        @Html.ActionLink("Hủy", "Index", "Admin", null, new { @class = "btn btn-default" })
    </div>
}
