@model IEnumerable<DD.Models.SanPham>
@{
    ViewBag.Title = "Danh Sách Sản Phẩm";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    int page = ViewBag.Page ?? 1;
    int pageSize = ViewBag.PageSize ?? 10;
    int totalPages = ViewBag.TotalPages ?? 1;
}

<link href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css" rel="stylesheet" />

<h2>Danh Sách Sản Phẩm</h2>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<p>Tổng số sản phẩm: @ViewBag.TotalRecords</p>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Mã Sản Phẩm</th>
            <th>Tên Sản Phẩm</th>
            <th>Loại Sản Phẩm</th>
            <th>Giá</th>
            <th>Số Lượng Tồn</th>
            <th>Hình Ảnh</th>
            <th>Thao Tác</th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Any())
        {
            foreach (var item in Model)
            {
                <tr id="sanpham-@item.MaSanPham">

                    <td>@item.MaSanPham</td>
                    <td>@item.TenSanPham</td>
                    <td>@item.LoaiSanPham</td>
                    <td>@item.Gia</td>
                    <td>@item.SoLuongTon</td>
                    <td>
                        @if (!string.IsNullOrEmpty(item.HinhAnh))
                        {
                            <img src="@Url.Content("~/Image/" + item.HinhAnh)" alt="@item.TenSanPham" style="width: 100px; height: auto;" />

                        }
                        else
                        {
                            <span>Không có hình</span>
                        }
                    </td>
                    <td>
                        @Html.ActionLink("Sửa", "Edit", new { id = item.MaSanPham }, new { @class = "btn btn-primary btn-sm" })

                        @using (Html.BeginForm("DeleteConfirmed", "SanPham", FormMethod.Post, new { onsubmit = "return confirm('Bạn có chắc chắn muốn xóa sản phẩm này không?');", @style = "display:inline;" }))
                        {
                            @Html.AntiForgeryToken()
                            @Html.Hidden("MaSanPham", item.MaSanPham)
                            <button type="submit" class="btn btn-danger btn-sm">Xóa</button>
                        }
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="7">Không có sản phẩm nào.</td>
            </tr>
        }
    </tbody>
</table>

<!-- Phân trang -->
<div class="pagination">
    @if (page > 1)
    {
        @Html.ActionLink("Trang trước", "Index", new { page = page - 1, pageSize }, new { @class = "btn btn-secondary" })
    }
    <span>Trang @page / @totalPages</span>
    @if (page < totalPages)
    {
        @Html.ActionLink("Trang sau", "Index", new { page = page + 1, pageSize }, new { @class = "btn btn-secondary" })
    }
</div>

<p>
    @Html.ActionLink("Thêm Sản Phẩm Mới", "Create", null, new { @class = "btn btn-success" })
</p>
@section Scripts {
    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")

    <script>
        $(document).ready(function () {
            var anchorId = '@TempData["AnchorId"]';
            if (anchorId) {
                var element = document.getElementById(anchorId);
                if (element) {
                    element.scrollIntoView({ behavior: 'smooth', block: 'center' });
                }
            }
        });
    </script>
}

