@model DD.Models.SanPham

@{
    ViewBag.Title = "Chỉnh sửa sản phẩm";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<h2>Chỉnh sửa sản phẩm</h2>

@using (Html.BeginForm("Edit", "SanPham", FormMethod.Post, new { enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.MaSanPham)

    <div class="form-group">
        @Html.LabelFor(m => m.TenSanPham)
        @Html.TextBoxFor(m => m.TenSanPham, new { @class = "form-control" })
        @Html.ValidationMessageFor(m => m.TenSanPham)
    </div>

    <div class="form-group">
        @Html.LabelFor(m => m.Gia)
        @Html.TextBoxFor(m => m.Gia, new { @class = "form-control", type = "number", step = "1000" })
        @Html.ValidationMessageFor(m => m.Gia)
    </div>

    <div class="form-group">
        @Html.LabelFor(m => m.SoLuongTon)
        @Html.TextBoxFor(m => m.SoLuongTon, new { @class = "form-control", type = "number", min = "0" })
        @Html.ValidationMessageFor(m => m.SoLuongTon)
    </div>

    <div class="form-group">
        @Html.LabelFor(m => m.LoaiSanPham)
        @Html.DropDownListFor(m => m.LoaiSanPham, new SelectList(ViewBag.LoaiSanPhamList as List<string>), "-- Chọn loại sản phẩm --", new { @class = "form-control" })
        @Html.ValidationMessageFor(m => m.LoaiSanPham)
    </div>

    <div class="form-group">
        @Html.LabelFor(m => m.MoTa)
        @Html.TextAreaFor(m => m.MoTa, new { @class = "form-control", rows = 3 })
    </div>

    <div class="form-group">
        @Html.LabelFor(m => m.HanSuDung)
        @Html.TextBoxFor(m => m.HanSuDung, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
    </div>

    <div class="form-group">
        @Html.Label("Ảnh hiện tại:")
        @if (!string.IsNullOrEmpty(Model.HinhAnh))
        {
            <img src="@Url.Content(Model.HinhAnh)" style="width: 100px;" />
        }
        else
        {
            <span>Không có ảnh</span>
        }
    </div>

    <div class="form-group">
        @Html.Label("Hình ảnh mới")
        <input type="file" name="imageFile" class="form-control" />
    </div>

    <div class="form-group">
        @Html.LabelFor(m => m.TrangThai)
        @Html.TextBoxFor(m => m.TrangThai, new { @class = "form-control" })
    </div>

    <button type="submit" class="btn btn-success">Lưu</button>
    @Html.ActionLink("Quay lại", "Index", null, new { @class = "btn btn-secondary ml-2" })
}
