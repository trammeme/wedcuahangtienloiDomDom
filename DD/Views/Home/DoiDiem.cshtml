@model DD.Models.TichDiem

@{
    ViewBag.Title = "Đổi điểm";
    Layout = "~/Views/Shared/_LayoutUser.cshtml";
}
<style>
    .container {
        max-width: 600px;
        margin-top: 40px;
    }

    .card {
        border-radius: 15px;
        overflow: hidden;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

    .card:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 20px rgba(0, 0, 0, 0.15);
    }

    .card-body {
        padding: 25px;
        background: linear-gradient(135deg, #ffffff, #f9f9f9);
    }

    .card-title {
        font-size: 1.8rem;
        font-weight: 600;
        text-align: center;
        color: #28a745;
        margin-bottom: 20px;
        position: relative;
    }

        .card-title::after {
            content: '';
            display: block;
            width: 50px;
            height: 3px;
            background: #28a745;
            margin: 10px auto 0;
            border-radius: 2px;
        }

    .list-group-item {
        background: transparent;
        border: none;
        padding: 10px 0;
        font-size: 1.1rem;
        color: #333;
        transition: color 0.3s ease;
    }

        .list-group-item:hover {
            color: #28a745;
        }

    .text-primary {
        color: #007bff !important;
        font-weight: 700;
    }

    .text-info {
        color: #17a2b8 !important;
        font-weight: 700;
    }

    .text-danger {
        color: #dc3545 !important;
        font-weight: 700;
    }

    .form-inline {
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 20px;
    }

    .form-control {
        border-radius: 8px;
        border: 2px solid #ced4da;
        padding: 8px 12px;
        font-size: 1rem;
        transition: border-color 0.3s ease, box-shadow 0.3s ease;
    }

        .form-control:focus {
            border-color: #28a745;
            box-shadow: 0 0 5px rgba(40, 167, 69, 0.3);
            outline: none;
        }

    .btn-success {
        background-color: #28a745;
        border: none;
        border-radius: 8px;
        padding: 10px 20px;
        font-weight: 600;
        color: #fff;
        transition: background-color 0.3s ease, transform 0.3s ease;
    }

        .btn-success:hover {
            background-color: #218838;
            transform: translateY(-2px);
        }

    #thongBao {
        border-radius: 8px;
        padding: 15px;
        margin-top: 20px;
        text-align: center;
        font-weight: 500;
    }

    .alert-success {
        background-color: #d4edda;
        color: #155724;
        border: 1px solid #c3e6cb;
    }

    .alert-danger {
        background-color: #f8d7da;
        color: #721c24;
        border: 1px solid #f5c6cb;
    }

    /* Responsive design */
    @@media (max-width: 768px) {
        .product-card {
            width: calc(50% - 20px); /* 2 sản phẩm trên một hàng cho màn hình nhỏ */
        }

        .form-inline {
            flex-direction: column;
            text-align: center;
        }

        .form-control {
            margin-bottom: 10px;
            width: 100%;
        }
    }

    @@media (max-width: 480px) {
        .product-card {
            width: 100%; /* 1 sản phẩm trên một hàng cho màn hình rất nhỏ */
        }

        .card-title {
            font-size: 1.5rem;
        }
    }
</style>
<div class="container mt-4">
    <div class="card shadow-sm border-0">
        <div class="card-body">
            <h3 class="card-title mb-4 text-success">🎁 Đổi điểm tích lũy</h3>

            @if (Model != null)
            {
                <ul class="list-group list-group-flush mb-4">
                    <li class="list-group-item">Điểm hiện tại: <strong class="text-primary">@Model.Diem</strong></li>
                    <li class="list-group-item">Cấp bậc: <strong class="text-info">@Model.CapBac</strong></li>
                    <li class="list-group-item">Ngày hết hạn: <strong class="text-danger">@Model.NgayHetHan</strong></li>/* ?.ToString("dd/MM/yyyy") */
                </ul>

                <div class="form-inline mb-3">
                    <label for="soDiem" class="mr-2 font-weight-bold">Số điểm muốn đổi:</label>
                    <input type="number" id="soDiem" class="form-control mr-3" min="1" max="@Model.Diem" style="width: 120px;" />
                    <button onclick="doiDiem()" class="btn btn-success">Đổi điểm</button>
                </div>

                <div id="thongBao" class="mt-3 alert d-none"></div>

                <script>
                    function doiDiem() {
                        var soDiem = $('#soDiem').val();
                        $.post('@Url.Action("DoiDiem", "Home")', { soDiem: soDiem }, function (res) {
                            var alertBox = $('#thongBao');
                            alertBox.removeClass('d-none alert-success alert-danger');

                            if (res.success) {
                                alertBox.addClass('alert-success').text(res.message);
                                setTimeout(() => location.reload(), 1500);
                            } else {
                                alertBox.addClass('alert-danger').text(res.message);
                            }
                        });
                    }
                </script>
            }
            else
            {
                <div class="alert alert-warning">
                    Không có dữ liệu tích điểm.
                </div>
            }
        </div>
    </div>
</div>
