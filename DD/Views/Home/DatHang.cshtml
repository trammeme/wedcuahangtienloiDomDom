@using DD.Models
@using System.Linq
@model List<DD.Models.GioHang>

@{
    ViewBag.Title = "DatHang";
    Layout = "~/Views/Shared/_LayoutUser.cshtml";
}

<h2>Thông tin đặt hàng</h2>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

@if (Model == null || !Model.Any())
{
    <p>Giỏ hàng của bạn đang trống.</p>
    <a href="@Url.Action("Index", "Home")" class="btn btn-primary">Tiếp tục mua sắm</a>
}
else
{
    <h4>Giỏ hàng</h4>
    <table class="table table-bordered">
        <thead>
            <tr>
                <th>Sản phẩm</th>
                <th>Giá</th>
                <th>Số lượng</th>
                <th>Thành tiền</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.sTenSanPham</td>
                    <td>@string.Format("{0:#,##0} VNĐ", item.dGia ?? 0)</td>
                    <td>@item.iSoLuong</td>
                    <td>@item.dThanhTien.ToString("#,##0") VNĐ</td>
                </tr>
            }
        </tbody>
    </table>
    <h4>Tổng số lượng: @ViewBag.TongSoLuong</h4>
    <h4>Tổng tiền: @ViewBag.TongTien.ToString("#,##0") VNĐ</h4>

    <h4>Thông tin giao hàng</h4>
    <form method="post" action="@Url.Action("DatHang", "Home")">
        <div class="form-group">
            <label>Địa chỉ giao hàng</label>
            <input type="text" class="form-control" name="diaChi" required />
        </div>
        <div class="form-group">
            <label>Số điện thoại</label>
            <input type="text" class="form-control" name="soDienThoai" required />
        </div>
        <div class="form-group">
            <label>Ngày giao (từ ngày mai đến 30 ngày sau)</label>
            <input type="date" class="form-control" name="ngayGiao" required />
        </div>
        <button type="submit" class="btn btn-success">Xác nhận đặt hàng</button>
    </form>
}