<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>DOMDOM - Admin Dashboard - @ViewBag.Title</title>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css" integrity="sha384-JcKb8q3iqJ61gNV9KGb8thSsNjpSL0n8PARn9HuZOnIxN0hoP+VmmDGMN5t9UJ0Z" crossorigin="anonymous" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" integrity="sha512-9usAa10IRO0HhonpyAIVpjrylPvoDwiPUiKdWk5t3PyolY1cOd4DSE0Ga+ri4AuTroPR5aQvXU9xC6qOPnzFeg==" crossorigin="anonymous" />
    <link rel="stylesheet" href="~/Content/layoutad.css" /> <!-- Giữ nếu file tồn tại -->
    <!-- CSS của Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">

    <!-- JavaScript của Bootstrap (đặt trước </body>) -->
    <style>
        body {
            font-family: 'Poppins', sans-serif;
            display: flex;
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        .sidebar {
            width: 250px;
            background-color: #343a40;
            color: white;
            height: 100vh;
            position: fixed;
            top: 0;
            left: 0;
            overflow-y: auto;
            padding-top: 20px;
            transition: transform 0.3s ease;
        }

            .sidebar .sidebar-brand {
                text-align: center;
                font-size: 1.5rem;
                font-weight: 700;
                padding: 10px 0;
                color: #ffc107;
            }

            .sidebar .menu-heading {
                padding: 10px;
                font-size: 1rem;
                font-weight: 600;
                color: #adb5bd;
            }

            .sidebar .menu-item {
                display: flex;
                align-items: center;
                padding: 12px 20px;
                color: #f8f9fa;
                text-decoration: none;
                transition: background 0.3s;
            }

                .sidebar .menu-item i {
                    margin-right: 10px;
                }

                .sidebar .menu-item:hover {
                    background-color: #495057;
                    color: #ffc107;
                }

                .sidebar .menu-item.active {
                    background-color: #495057;
                    color: #ffc107;
                }

        .main-content {
            margin-left: 250px;
            padding: 20px;
            flex-grow: 1;
            background-color: #f1f3f5;
            min-height: 100vh;
            transition: margin-left 0.3s ease;
        }

        /* Responsive */
        @@media (max-width: 768px) {
            .sidebar {
                transform: translateX(-250px);
            }

                .sidebar.active {
                    transform: translateX(0);
                }

            .main-content {
                margin-left: 0;
            }

            .navbar-toggler {
                display: block;
            }
        }

        .navbar-toggler {
            display: none;
            position: fixed;
            top: 10px;
            left: 10px;
            z-index: 1000;
        }
    </style>
</head>
<body>
    <!-- Nút toggle sidebar cho mobile -->
    <button class="navbar-toggler btn btn-dark" onclick="$('.sidebar').toggleClass('active')">
        <i class="fas fa-bars"></i>
    </button>

    <!-- Sidebar -->
    <div class="sidebar">
        <div class="sidebar-brand">
            <h2>DOMDOM</h2>
        </div>
        <div class="sidebar-menu">
            <div class="menu-heading">Quản lý chung</div>
            <a href="@Url.Action("Index", "SanPham")" class="menu-item">
                <i class="fas fa-box"></i>
                <span>Quản lý sản phẩm</span>
            </a>
            <a href="@Url.Action("Index", "SanPhamKhuyenMai")" class="menu-item">
                <i class="fas fa-box"></i>
                <span>Quản lý sản phẩm khuyến mãi</span>
            </a>
            <div class="menu-heading">Khách hàng</div>
            <a href="@Url.Action("Index", "QuanLyUser")" class="menu-item">
                <i class="fas fa-users"></i>
                <span>Quản lý khách hàng</span>
            </a>
            <a href="@Url.Action("Index", "QuanLiBinhLuan")" class="menu-item">
                <i class="fas fa-comments"></i>
                <span>Quản lý bình luận</span>
            </a>
            <div class="menu-heading">Marketing</div>
            <a href="@Url.Action("Index", "QLKhuyenMai")" class="menu-item">
                <i class="fas fa-percent"></i>
                <span>Quản lý khuyến mãi</span>
            </a>
            <a href="@Url.Action("Index", "QuanLyDonHang")" class="menu-item">
                <i class="fas fa-receipt"></i>
                <span>Quản lý đơn hàng</span>
            </a>
            <a href="@Url.Action("Index", "QuanLyTichDiem")" class="menu-item">
                <i class="fas fa-star"></i>
                <span>Quản lý tích điểm</span>
            </a>
        </div>
    </div>

    <!-- Nội dung chính -->
    <div class="main-content">
        <div class="container-fluid">
            @RenderBody()
        </div>
    </div>

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>

    <script src="https://code.jquery.com/jquery-3.5.1.min.js" integrity="sha256-9/aliU8dGd2tb6OSsuzixeV4y/faTqgFtohetphbbj0=" crossorigin="anonymous"></script>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.bundle.min.js" integrity="sha384-LtrjvnR4Twt/qOuYxE721u19sVFLVSA4hf/rRt6PrZTmiPltdZcI7q7PXQBYTKyf" crossorigin="anonymous"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>