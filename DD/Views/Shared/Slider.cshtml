<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Slider Mở Rộng</title>
    <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/3.3.7/css/bootstrap.min.css">
    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #f9f9f9;
            margin: 0;
            padding: 0;
        }

        .container {
            display: flex;
            flex-direction: row;
            min-height: 100vh;
            width: 100%; /* Đảm bảo container chiếm toàn bộ chiều rộng */
            padding: 0; /* Loại bỏ padding mặc định */
        }


        /* Sidebar */
        .sidebar {
            width: 250px;
            background-color: #ffeb3b;
            padding: 20px;
            box-shadow: 2px 0 5px rgba(0, 0, 0, 0.1);
        }

            .sidebar h2 {
                color: #3f51b5;
            }

            .sidebar a {
                display: block;
                color: #000;
                text-decoration: none;
                padding: 10px 0;
            }

                .sidebar a:hover {
                    background-color: #3f51b5;
                    color: #fff;
                }

        /* Nội dung chính */
        .content {
            flex: 1;
            padding: 20px;
            display: flex;
            flex-direction: column;
        }

        /* Carousel */
        .carousel {
            height: 500px;
            margin-bottom: 20px;
        }

        .carousel-inner > .item > img {
            width: 100%;
            height: 500px;
            object-fit: cover;
        }

        .carousel-caption h3 {
            font-size: 24px;
            font-weight: bold;
        }

        .carousel-caption p {
            font-size: 16px;
        }

        .btn-custom {
            background-color: #f39c12;
            color: white;
            border-radius: 5px;
            margin-top: 10px;
            padding: 8px 16px;
            border: none;
            cursor: pointer;
        }

        .carousel-control {
            background-image: none;
        }

            .carousel-control .glyphicon-chevron-left,
            .carousel-control .glyphicon-chevron-right {
                font-size: 30px;
                color: #f39c12;
            }

        /* Sản phẩm */
        .product-section {
            margin-top: 20px;
        }

        .product-container {
            display: flex;
            flex-wrap: wrap;
            justify-content: flex-start;
        }

        .product-card {
            border: 1px solid #ccc;
            border-radius: 5px;
            padding: 10px;
            margin: 10px;
            width: calc(30% - 20px);
            box-shadow: 2px 2px 5px rgba(0, 0, 0, 0.1);
            text-align: center;
            cursor: pointer;
            background-color: #fff;
            transition: transform 0.2s;
        }

            .product-card:hover {
                transform: translateY(-5px);
            }

            .product-card img {
                max-width: 100%;
                height: auto;
                border-radius: 5px;
            }

        .description {
            margin-top: 10px;
            font-size: 14px;
            color: #555;
        }

        #productDetail {
            border: 1px solid #ccc;
            padding: 20px;
            background-color: #fff;
            position: fixed;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            z-index: 1000;
            display: none;
            width: 50%;
            box-shadow: 0 0 10px rgba(0,0,0,0.2);
        }
    </style>

</head>
<body>
    <div class="container">
        <div class="row">
            <div class="col-xs-12">
                <div id="carousel1" class="carousel slide carousel-fade" data-ride="carousel">
                    <ol class="carousel-indicators">
                        <li data-target="#carousel1" data-slide-to="0" class="active"></li>
                        <li data-target="#carousel1" data-slide-to="1"></li>
                        <li data-target="#carousel1" data-slide-to="2"></li>
                    </ol>
                    <div class="carousel-inner">
                        <div class="item active">
                            <img class="img-responsive" src="~/Images/slider/dagachien.png" alt="thumb">
                            <div class="carousel-caption">
                                <!-- Có thể thêm nội dung vào đây -->
                            </div>
                        </div>
                        <div class="item">
                            <img class="img-responsive" src="~/Images/slider/taoxanhtra.jpg" alt="thumb">
                            <div class="carousel-caption">
                                <!-- Có thể thêm nội dung vào đây -->
                            </div>
                        </div>
                        <div class="item">
                            <img class="img-responsive" src="~/Images/slider/trasuanuong.jpg" alt="thumb">
                            <div class="carousel-caption">
                                <!-- Có thể thêm nội dung vào đây -->
                            </div>
                        </div>
                    </div>
                    <a class="left carousel-control" href="#carousel1" data-slide="prev">
                        <span class="glyphicon glyphicon-chevron-left"></span>
                    </a>
                    <a class="right carousel-control" href="#carousel1" data-slide="next">
                        <span class="glyphicon glyphicon-chevron-right"></span>
                    </a>
                </div>
            </div>
        </div>
        <hr>
    </div>

    <script src="https://ajax.googleapis.com/ajax/libs/jquery/1.12.4/jquery.min.js"></script>
    <script src="https://maxcdn.bootstrapcdn.com/bootstrap/3.3.7/js/bootstrap.min.js"></script>
</body>
</html>
